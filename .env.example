# SDR Jarvis — Environment Variables
# Copy this file to .env.local and fill in your values

# ── LLM (default: OpenAI) ───────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Use a model your key can access (e.g. gpt-4o-mini, gpt-4o, gpt-4.1-mini).
LLM_MODEL=gpt-4o-mini

# Optional — xAI Grok instead of OpenAI (set LLM_PROVIDER=xai and fill below)
# LLM_PROVIDER=xai
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxx
# XAI_MODEL=grok-4.1-fast

# ── Supabase ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Resend) ──────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=onboarding@resend.dev
REPLY_TO_EMAIL=you@yourdomain.com

# ── Google Custom Search (for research agent) ───────
# Free: 100 queries/day. Setup: https://programmablesearchengine.google.com
GOOGLE_SEARCH_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SEARCH_CX=xxxxxxxxxxxxxxxxx

# ── X / Twitter API (for lead discovery) ─────────────
# Free: 1,500 reads/month. Setup: https://developer.x.com
X_BEARER_TOKEN=

# ── Google Calendar OAuth (optional) ────────────────
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPx-xxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── LangSmith (observability — optional) ────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxx
# LANGCHAIN_PROJECT=sdr-jarvis

# ── Stripe Billing ─────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_GROWTH_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend Webhooks ─────────────────────────────────
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cron Job ────────────────────────────────────────
CRON_SECRET=your-random-cron-secret-here
# Optional — documented default for daily-lead-refresh (UTC). Actual schedule is in vercel.json.
CRON_HOUR=12

# ── Slack (optional) ────────────────────────────────
SLACK_WEBHOOK_URL=
# Slack incoming webhook URL. Leave empty to disable notifications.

# ── App ─────────────────────────────────────────────
# Used for links in emails, etc. OAuth always redirects to the current browser origin + /auth/callback
# so local dev works even when this points at production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase → Authentication → URL configuration: add Redirect URLs for every host you use, e.g.
# http://localhost:3000/auth/callback and https://your-domain.com/auth/callback

# Optional — Calendly link for "Book a demo" on the landing page (opens in a new tab)
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/intro

# OAuth (enable providers in Supabase Auth → Providers, then set true here)
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=false
NEXT_PUBLIC_LINKEDIN_OAUTH_ENABLED=false

# Product Hunt GraphQL (optional — discovery Product Hunt source)
# PRODUCT_HUNT_TOKEN=

# GitHub API (optional — raises unauthenticated rate limit for discovery)
# GITHUB_TOKEN=

# Apollo — used for all lead discovery (People Search). Set on the server (e.g. Vercel).
# Users do not need their own key. Free tier: 50 credits/month; upgrade as you scale.
# APOLLO_API_KEY=

# Minimum ICP score (0–100) for discovery/import validation. Tune gradually (e.g. 25 → 30).
# MIN_LEAD_SCORE=20

# ── Deliverability & guardrails ────────────────────
# Max leads processed per UTC day (pipeline), across runs
DAILY_LEAD_PROCESSING_CAP=30

# Comma-separated emails allowed to access /dashboard/admin until you set is_admin in DB
# ADMIN_BOOTSTRAP_EMAILS=you@yourdomain.com

# Optional — email verification on import (NeverBounce v4 key)
# NEVERBOUNCE_API_KEY=secret_xxxxxxxx

# Optional — LangSmith tracing for LangGraph debugging
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=sdr-jarvis
